# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# LibreOffice の編集中ロックファイル
.~lock.*#

# 一時ファイル（LibreOffice のエクスポート途中など）
*.tmp

# PDF / PPTX から書き出した中間画像。正本は docs/ の PDF・DOCX 側なのでコミットしない
/page-*.jpg
/slide-*.jpg
docs/page-*.jpg
docs/slide-*.jpg
docs/allphase-*.jpg
docs/kobutsu-page-*.jpg

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# テンプレートだけは追跡する（実際の値は入っていない）
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
