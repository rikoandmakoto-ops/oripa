# =============================================================
# このファイルを .env.local にコピーして値を埋めてください。
#   cp .env.example .env.local
# .env.local は .gitignore 済みです。絶対にコミットしないこと。
# =============================================================

# -------------------------------------------------------------
# Supabase
#   ダッシュボード > Project Settings > API から取得
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role キー。RLS を完全に無視できる強力な鍵。
# サーバー側でしか使わない。NEXT_PUBLIC_ を付けないこと。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# -------------------------------------------------------------
# 開発用
#   決済を通さずポイントを付与するボタンを出す。
#   NODE_ENV=production では有効にしていても無視される。
# -------------------------------------------------------------
ENABLE_DEV_TOPUP=true

# -------------------------------------------------------------
# 事業者情報（特定商取引法・古物営業法の表示に使用）
#   公開前に必ず実際の値を設定すること。
# -------------------------------------------------------------
NEXT_PUBLIC_SERVICE_NAME=ORIPA
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_REPRESENTATIVE=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_HOURS=平日 10:00-18:00

# 古物商許可番号（例: 第123456789012号）と交付した公安委員会
NEXT_PUBLIC_ANTIQUE_LICENSE_NO=
NEXT_PUBLIC_ANTIQUE_LICENSE_AUTHORITY=

# 法的文書の最終更新日
NEXT_PUBLIC_LEGAL_UPDATED=2026-07-19

# -------------------------------------------------------------
# Stripe（Phase 2 / 現時点では未使用）
# -------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
