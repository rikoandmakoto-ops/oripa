# =============================================================
# このファイルを .env.local にコピーして値を埋めてください。
#   cp .env.example .env.local
# .env.local は .gitignore 済みです。絶対にコミットしないこと。
# =============================================================

# -------------------------------------------------------------
# Supabase
#   ダッシュボード > Project Settings > API から取得
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role キー。RLS を完全に無視できる強力な鍵。
# サーバー側でしか使わない。NEXT_PUBLIC_ を付けないこと。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# -------------------------------------------------------------
# 開発用
#   決済を通さずポイントを付与するボタンを出す。
#   NODE_ENV=production では有効にしていても無視される。
# -------------------------------------------------------------
ENABLE_DEV_TOPUP=true

# -------------------------------------------------------------
# 事業者情報（特定商取引法・古物営業法の表示に使用）
#   公開前に必ず実際の値を設定すること。
# -------------------------------------------------------------
NEXT_PUBLIC_SERVICE_NAME=ORIPA
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_REPRESENTATIVE=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_HOURS=平日 10:00-18:00

# 古物商許可番号（例: 第123456789012号）と交付した公安委員会
NEXT_PUBLIC_ANTIQUE_LICENSE_NO=
NEXT_PUBLIC_ANTIQUE_LICENSE_AUTHORITY=

# 法的文書の最終更新日
NEXT_PUBLIC_LEGAL_UPDATED=2026-07-19

# -------------------------------------------------------------
# Stripe（ポイントチャージ決済）
#   未設定でもアプリは起動する。その場合チャージボタンは押せず、
#   /api/checkout は 503、Webhook は 404 を返す。
#
#   詳しい取得手順は docs/stripe-setup.md を参照。
# -------------------------------------------------------------

# シークレットキー。ダッシュボード > 開発者 > APIキー
# テスト環境は sk_test_ 、本番は sk_live_ で始まる。絶対に公開しないこと。
STRIPE_SECRET_KEY=

# Webhook の署名シークレット。ダッシュボード > 開発者 > Webhook で
# エンドポイントを登録すると発行される（whsec_ で始まる）。
# ローカルでは `stripe listen` が表示する値を使う。
# これが無いとポイントは一切付与されない。
STRIPE_WEBHOOK_SECRET=

# 決済後の戻り先に使う本番ドメイン（末尾スラッシュなし）。
# 未設定ならリクエストの Origin / Vercel のドメインから自動判定する。
# 例: https://oripa.example.com
NEXT_PUBLIC_SITE_URL=
